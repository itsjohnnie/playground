{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "vroom:helicopter",
      "materials": {
        "default": "entity_alphatest",
        "glass": "entity_alphablend"
      },
      "textures": {
        "default": "textures/entity/vroom_atlas"
      },
      "geometry": {
        "default": "geometry.vroom.helicopter"
      },
      "render_controllers": [
        "controller.render.vroom.vehicle"
      ],
      "spawn_egg": {
        "base_color": "#D7262E",
        "overlay_color": "#F4F4F0"
      },
      "scripts": {
        "animate": [
          "drive"
        ],
        "initialize": [
          "v.a0 = 0;",
          "v.a1 = 0;"
        ],
        "pre_animation": [
          "v.a0 = v.a0 + q.delta_time * ((q.has_rider ? 1400 : 0) + q.ground_speed * 0);",
          "v.a1 = v.a1 + q.delta_time * ((q.has_rider ? 2400 : 0) + q.ground_speed * 0);"
        ]
      },
      "animations": {
        "drive": "animation.vroom.helicopter.drive"
      }
    }
  }
}
